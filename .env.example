# OpenClaw Team 环境变量配置示例
# 复制此文件为 .env 并修改配置

# 注册邀请码
INVITE_CODE=OPENCLAW2026

# 品牌名称（显示在界面上）
BRAND_NAME=OPENCLAW-TEAM

# 服务器端口（可选，默认 8888）
# PORT=8888

# 数据存储目录（可选，默认 ~/Desktop/alldata）
# DATA_DIR=/path/to/data

# OpenClaw Gateway 配置（可选）
# GATEWAY_URL=http://127.0.0.1:18789
# GATEWAY_TOKEN=your_token_here
